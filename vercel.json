{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/v2/(.*)",
      "destination": "https://mmax-anime-api.vercel.app/api/v2/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
